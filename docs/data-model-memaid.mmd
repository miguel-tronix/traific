classDiagram
    class Tenant {
        +UUID id
        +VARCHAR name
        +JSONB settings
        +TIMESTAMP created_at
    }

    class RoadSegment {
        +UUID id
        +UUID tenant_id
        +VARCHAR name
        +GEOMETRY(LineString, 4326) geometry
        +INTEGER speed_limit
        +INTEGER lanes
        +JSONB metadata
    }

    class Sensor {
        +UUID id
        +UUID tenant_id
        +UUID road_segment_id
        +VARCHAR type
        +VARCHAR model
        +GEOMETRY(Point, 4326) location
        +JSONB config
        +TIMESTAMP last_seen
        +BOOLEAN active
    }

    class TrafficObservation {
        <<Time-series>>
        +UUID id
        +UUID tenant_id
        +UUID sensor_id
        +TIMESTAMP timestamp
        +INTEGER volume
        +FLOAT avg_speed
        +INTEGER occupancy_pct
        +INTEGER headway_seconds
        +JSONB vehicle_class_counts
        +JSONB raw_data
    }
    
    class TrafficAggregates {
        <<Partitioned by date>>
        +DATE date
        +INTEGER hour
        +UUID tenant_id
        +UUID road_segment_id
        +INTEGER total_volume
        +FLOAT avg_speed
        +INTEGER peak_volume
        +TIME peak_hour
    }

    class Incident {
        +UUID id
        +UUID tenant_id
        +UUID road_segment_id
        +VARCHAR type
        +GEOMETRY(Point, 4326) location
        +TIMESTAMP start_time
        +TIMESTAMP end_time
        +VARCHAR severity
        +VARCHAR status
        +JSONB impact_metrics
    }

    class Prediction {
        +UUID id
        +UUID tenant_id
        +UUID road_segment_id
        +TIMESTAMP prediction_time
        +TIMESTAMP valid_from
        +TIMESTAMP valid_to
        +INTEGER predicted_volume
        +FLOAT predicted_speed
        +FLOAT confidence
        +VARCHAR model_version
    }

    Tenant "1" -- "0..*" RoadSegment : owns
    Tenant "1" -- "0..*" Sensor : deploys
    RoadSegment "1" -- "0..*" Sensor : contains
    RoadSegment "1" -- "0..*" Incident : affected_by
    Sensor "1" -- "0..*" TrafficObservation : generates
    RoadSegment "1" -- "0..*" TrafficAggregates : summarizes
    RoadSegment "1" -- "0..*" Prediction : forecasted
    
    %% Notes for time-series optimization
    note for TrafficObservation "Partitioned by month\nIndex: (sensor_id, timestamp DESC)\nHypertable (TimescaleDB)"
    note for TrafficAggregates "Partitioned by date\nComposite PK: (date, hour, road_segment_id)"