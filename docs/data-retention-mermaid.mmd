graph TD
    %% Global Title
    title["<b>Data Retention Policy & Lifecycle Management</b>"]
    style title fill:#ffffff,stroke:none,font-size:20px

    %% Timeline/Latency Guide
    subgraph Timeline ["<b>Data Aging & Access Latency</b>"]
        direction LR
        T1[Real-time / MS] --> T2[Minutes / Hours] --> T3[Days / Months] --> T4[Years / Decades]
    end
    style Timeline fill:#f9f9f9,stroke:#ccc,stroke-dasharray: 5 5

    %% Data Tiers
    subgraph Hot ["<b>Tier 1: Operational (Hot)</b>"]
        direction TB
        H1[("<b>ElastiCache (Redis)</b><br/>Current State")]
        H2[("<b>RDS / PostGIS</b><br/>Active Observations")]
        noteH["Retention: 7 Days"]
    end

    subgraph Warm ["<b>Tier 2: Tactical (Warm)</b>"]
        direction TB
        W1[("<b>S3 Standard</b><br/>JSON Raw Buffer")]
        W2[("<b>RDS Aggregates</b><br/>Hourly/Daily Rollups")]
        noteW["Retention: 30 Days"]
    end

    subgraph Cold ["<b>Tier 3: Analytical (Cold)</b>"]
        direction TB
        C1[("<b>S3 Intelligent Tiering</b><br/>Parquet / Snappy")]
        C2[("<b>Glue Catalog</b><br/>Partitioned Metadata")]
        noteC["Retention: 7 Years"]
    end

    subgraph Archive ["<b>Tier 4: Regulatory (Archive)</b>"]
        direction TB
        A1[("<b>S3 Glacier Deep Archive</b><br/>WORM Compliance")]
        noteA["Retention: 10+ Years"]
    end

    %% Movement / ETL Logic
    H2 ==>|Stream ETL| W1
    W1 ==>|Compaction / Glue| C1
    C1 ==>|Lifecycle Policy| A1

    %% Analytics Access
    Athena{{Amazon Athena}} -.->|SQL Query| C1
    SageMaker{{SageMaker}} -.->|Model Training| C1

    %% Styling for Professionalism
    style Hot fill:#fff1f0,stroke:#cf1322,stroke-width:2px
    style Warm fill:#fffbe6,stroke:#d4b106,stroke-width:2px
    style Cold fill:#e6f7ff,stroke:#1890ff,stroke-width:2px
    style Archive fill:#f0f5ff,stroke:#1d39c4,stroke-width:2px
    
    style noteH fill:none,stroke:none,font-style:italic
    style noteW fill:none,stroke:none,font-style:italic
    style noteC fill:none,stroke:none,font-style:italic
    style noteA fill:none,stroke:none,font-style:italic
    
    style Athena fill:#efdbff,stroke:#722ed1
    style SageMaker fill:#efdbff,stroke:#722ed1